# =============================================================================
# Resume PRO Backend - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
# =============================================================================

# ================= SERVER CONFIG =================
# Server port (default: 5000)
PORT=5000

# Frontend URL for CORS (default: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Node environment (development or production)
NODE_ENV=development

# Cookie domain for production (e.g., yourdomain.com)
# COOKIE_DOMAIN=yourdomain.com

# ================= SECURITY =================
# Rate limiting (optional)
# LOGIN_RATE_LIMIT_WINDOW_MS=60000 (1 minute)
# LOGIN_RATE_LIMIT_MAX=10
# LOCKOUT_DURATION_MS=900000 (15 minutes)
# MAX_FAILED_ATTEMPTS=5

# Trust proxy (set to true if behind proxy/load balancer)
# TRUST_PROXY=true

# ================= AUTH SECURITY =================
# JWT secret for signing access tokens
# IMPORTANT: Use a strong random string in production!
JWT_SECRET=your-super-secret-jwt-key-change-this

# JWT secret for signing refresh tokens
# IMPORTANT: Use a different strong random string in production!
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this

# Token expiration times (optional, defaults shown)
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=7d

# ================= SUPABASE (Optional) =================
# Cloud database service
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Project URL
SUPABASE_URL=https://your-project.supabase.co

# Service role key (has admin privileges - keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ================= RAZORPAY PAYMENTS (Optional) =================
# Payment processing via Razorpay
# Get these from: https://dashboard.razorpay.com/app/settings

# Key ID from Razorpay dashboard
RAZORPAY_KEY_ID=your-key-id

# Key secret from Razorpay dashboard
RAZORPAY_KEY_SECRET=your-key-secret

# Webhook secret from Razorpay dashboard (optional, for production)
# Get from: https://dashboard.razorpay.com/app/settings/webhooks
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Payment currency (default: INR)
# RAZORPAY_CURRENCY=INR

# Price in paise (default: 99900 = ₹999)
# PRO_PRICE_PAISE=99900

# ================= EMAIL (Recommended: Resend) =================
# Email sending via Resend API (recommended)
# Get from: https://resend.com/api-keys

# Resend API key
RESEND_API_KEY=re_123456789

# From email address (must be verified in Resend for production)
EMAIL_FROM=onboarding@resend.dev

# ================= EMAIL (Alternative: SMTP) =================
# Email sending via SMTP
# You can use any SMTP provider (Gmail, SendGrid, Mailgun, etc.)

# SMTP host
# SMTP_HOST=smtp.gmail.com

# SMTP port (465 for SSL, 587 for TLS)
# SMTP_PORT=587

# SMTP username (usually your email address)
# SMTP_USER=your-email@gmail.com

# SMTP password or app-specific password
# SMTP_PASS=your-app-password

# From email address
# SMTP_FROM=Resume PRO <noreply@yourdomain.com>

# ================= AI FEATURES (Optional) =================
# OpenAI API for AI-powered features
# Get from: https://platform.openai.com/api-keys

# OPENAI_API_KEY=sk-your-api-key

# ================= CONTACT FORM (Optional) =================
# Admin email to receive contact form notifications
ADMIN_EMAIL=support@yourdomain.com

# WhatsApp number for chat button (include country code, no +)
# Example: 919989998990 (for +91 99899 89990)
WHATSAPP_NUMBER=919999999999

# =============================================================================
# FEATURE STATUS
# =============================================================================
# Features will be DISABLED if their required variables are not set:
#
# | Feature            | Required Keys                              |
# |--------------------|-------------------------------------------|
# | Supabase           | SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY   |
# | Razorpay Payments | RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET     |
# | Email (SMTP)       | SMTP_HOST, SMTP_PORT, SMTP_USER,            |
# |                    | SMTP_PASS, SMTP_FROM                      |
# | AI Features        | OPENAI_API_KEY                            |
#
# The server will start and log which features are enabled/disabled.
# =============================================================================